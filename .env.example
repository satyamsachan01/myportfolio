# Public URL of the deployed site: canonical URLs, Open Graph, sitemap.xml and robots.txt.
VITE_SITE_URL=https://your-domain.com

# Contact form, option 1: Web3Forms access key (free at web3forms.com). Public by design, safe in frontend code.
VITE_WEB3FORMS_KEY=

# Contact form, option 2: any endpoint that accepts a JSON POST (e.g. https://formspree.io/f/xxxx).
VITE_CONTACT_ENDPOINT=
